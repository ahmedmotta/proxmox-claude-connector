# Proxmox Claude Connector - settings
# Installed location: /etc/pve-connector/env (keep it chmod 600, it holds secrets)

# ---- Proxmox API ------------------------------------------------------------
# Any cluster node. Use the LAN IP the connector can reach.
PVE_HOST=192.168.1.10
PVE_PORT=8006
# API token: user@realm!tokenname  (see README: "Create the API token")
PVE_TOKEN_ID=root@pam!claude
PVE_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Proxmox uses a self-signed certificate by default. Either point PVE_CA_CERT at a copy of
# /etc/pve/pve-root-ca.pem (recommended) or set PVE_VERIFY_SSL=false on a trusted LAN.
PVE_VERIFY_SSL=true
# PVE_CA_CERT=/etc/pve-connector/pve-root-ca.pem

# ---- SSH (optional: host shell + commands inside LXC containers) ------------
PVE_SSH_ENABLED=false
# PVE_SSH_HOST=192.168.1.10          # defaults to PVE_HOST
# PVE_SSH_USER=root
# PVE_SSH_KEY_PATH=/var/lib/pve-connector/id_ed25519

# ---- Connector --------------------------------------------------------------
# The public HTTPS address Claude uses (your Cloudflare Tunnel hostname). No trailing slash.
CONNECTOR_PUBLIC_URL=https://pve-mcp.example.com
CONNECTOR_BIND_HOST=127.0.0.1
CONNECTOR_PORT=8765
# Typed once on the approval page when you add the connector in Claude.
# Plain text works; a hash from `pve-connector hash-password` is better.
CONNECTOR_ADMIN_PASSWORD=change-me-to-a-long-password
CONNECTOR_DATA_DIR=/var/lib/pve-connector

# full     = everything (deletes, host shell, commands in guests)
# safe     = create/change/start/clean shutdown; no deletes, hard stops, rollbacks or shell
# readonly = look only
CONNECTOR_MODE=full
# Guests that may never be stopped, deleted, rolled back or restored over (comma separated).
# Put the connector's own container here, plus anything critical (firewall, PBX...).
CONNECTOR_PROTECTED_VMIDS=
# If set, the connector only sees and touches these VMIDs.
CONNECTOR_ALLOWED_VMIDS=
# OAuth redirect hosts that may register (blocks other apps from using your connector).
CONNECTOR_ALLOWED_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
# Longest a tool call waits for a Proxmox task (seconds) before returning its id.
CONNECTOR_MAX_WAIT=90
CONNECTOR_LOG_LEVEL=INFO
